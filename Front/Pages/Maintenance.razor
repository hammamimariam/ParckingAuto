@page "/maintenance"
@using ParckingAuto.DTO
@using Front.Helpers
@inject HttpClient Http
@inject DialogService Dialog

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="title-custom"><i class="bi bi-tools me-2"></i>Gestion de la Maintenance</h2>
        <button class="btn btn-custom-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle me-1"></i> Nouvelle Intervention
        </button>
    </div>

  @if (!ShowForm)
    {
        <div class="card card-custom p-3 mb-4 shadow-sm">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input class="form-control" value="@SearchTerm" @oninput="OnSearchChanged" placeholder="Rechercher intervention, fournisseur..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="FilterVehiculeId">
                        <option value="0">Tous les véhicules</option>
                        @foreach (var v in Vehicles)
                        {
                            <option value="@v.Id">@v.Immatriculation — @v.Marque @v.Modele</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="FilterType">
                        <option value="">Tous les types</option>
                        @foreach (var type in InterventionTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>
            @if (SelectedIds.Count > 0)
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="text-muted">@SelectedIds.Count sélectionné(s)</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">
                        <i class="bi bi-trash me-1"></i> Supprimer la sélection
                    </button>
                </div>
            }
        </div>
    }

    @if (ShowForm)
    {
        <div class="card card-custom p-4 mb-4 animate-slide-down">
            <h4 class="mb-3 text-navy">@(CurrentMaintenance.Id == 0 ? "Ajouter une Intervention" : "Modifier l'Intervention")</h4>

            @if (CurrentMaintenance.Id == 0)
            {
                <div class="mb-4">
                    <label class="form-label fw-semibold">Véhicule(s) concerné(s) *</label>
                    <div class="vehicle-select-grid">
                        @foreach (var v in Vehicles)
                        {
                            var selected = SelectedVehicleIds.Contains(v.Id);
                            <label class="vehicle-select-item @(selected ? "selected" : "")">
                                <input type="checkbox" checked="@selected" @onchange="e => ToggleVehicle(v.Id, e.Value)" />
                                <span>
                                    <strong>@v.Immatriculation</strong>
                                    <small class="d-block text-muted">@v.Marque @v.Modele</small>
                                </span>
                            </label>
                        }
                    </div>
                    <small class="text-muted">Sélection multiple : une intervention sera créée pour chaque véhicule coché.</small>
                    @if (SelectedVehicleIds.Count > 0)
                    {
                        <div class="vehicle-info-panel mt-3">
                            @if (SelectedVehicleIds.Count == 1)
                            {
                                var v = GetVehicle(SelectedVehicleIds.First());
                                if (v != null)
                                {
                                    <div class="fw-semibold text-navy mb-2">@v.Immatriculation — @v.Marque @v.Modele</div>
                                    <div class="row g-2 small">
                                        <div class="col-md-3"><span class="text-muted">Kilométrage :</span> <strong>@v.Kilometrage.ToString("N0") km</strong></div>
                                        <div class="col-md-3"><span class="text-muted">Carburant :</span> @v.TypeCarburant</div>
                                        <div class="col-md-3"><span class="text-muted">Statut :</span> @v.Statut</div>
                                        <div class="col-md-3"><span class="text-muted">Année :</span> @(v.AnneeFabrication > 0 ? v.AnneeFabrication.ToString() : "—")</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="fw-semibold text-navy mb-2">@SelectedVehicleIds.Count véhicules sélectionnés</div>
                                <ul class="mb-0 small">
                                    @foreach (var id in SelectedVehicleIds)
                                    {
                                        var v = GetVehicle(id);
                                        if (v != null)
                                        {
                                            <li>@v.Immatriculation — @v.Marque @v.Modele <span class="text-muted">(@v.Kilometrage.ToString("N0") km)</span></li>
                                        }
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label">Véhicule</label>
                    <select class="form-select" @bind="CurrentMaintenance.VehiculeId" @bind:after="OnEditVehicleChanged">
                        @foreach (var v in Vehicles)
                        {
                            <option value="@v.Id">@v.Immatriculation — @v.Marque @v.Modele</option>
                        }
                    </select>
                </div>
                @if (GetVehicle(CurrentMaintenance.VehiculeId) is { } editVehicle)
                {
                    <div class="col-12 mb-3">
                        <div class="vehicle-info-panel">
                            <div class="fw-semibold text-navy mb-2">@editVehicle.Immatriculation — @editVehicle.Marque @editVehicle.Modele</div>
                            <div class="row g-2 small">
                                <div class="col-md-3"><span class="text-muted">Kilométrage actuel :</span> <strong>@editVehicle.Kilometrage.ToString("N0") km</strong></div>
                                <div class="col-md-3"><span class="text-muted">Carburant :</span> @editVehicle.TypeCarburant</div>
                                <div class="col-md-3"><span class="text-muted">Statut :</span> @editVehicle.Statut</div>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="mb-4">
                <label class="form-label fw-semibold">Types d'intervention *</label>
                <div class="intervention-type-grid">
                    @foreach (var type in InterventionTypes)
                    {
                        var checkedType = SelectedInterventionTypes.Contains(type);
                        <label class="intervention-type-item @(checkedType ? "selected" : "")">
                            <input type="checkbox" checked="@checkedType" @onchange="e => ToggleInterventionType(type, e.Value)" />
                            <span>@type</span>
                        </label>
                    }
                </div>
                @if (SelectedInterventionTypes.Contains("Autre"))
                {
                    <input class="form-control mt-2" @bind="AutreIntervention" placeholder="Précisez l'intervention..." />
                }
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Date d'intervention</label>
                    <input type="date" class="form-control" @bind="CurrentMaintenance.DateIntervention" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Kilométrage (km)</label>
                    <input type="number" class="form-control" @bind="CurrentMaintenance.KilometrageIntervention" min="0" readonly />
                    <small class="text-muted">Chargé automatiquement depuis le véhicule sélectionné.</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Coût total (DT)</label>
                    <input type="number" step="0.001" class="form-control" @bind="CurrentMaintenance.Cout" placeholder="0.000" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fournisseur / Garage</label>
                    <input class="form-control" @bind="CurrentMaintenance.Fournisseur" placeholder="Nom du garage" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Facture (PDF, image...)</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" />
                    @if (UploadingFile)
                    {
                        <div class="text-info mt-1"><i class="spinner-border spinner-border-sm me-1"></i> Upload en cours...</div>
                    }
                    else if (!string.IsNullOrEmpty(CurrentMaintenance.Facture))
                    {
                        <div class="text-success mt-1">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <a href="@ApiUrlHelper.FileUrl(Http, CurrentMaintenance.Facture)" target="_blank" class="link-custom">@GetFileName(CurrentMaintenance.Facture)</a>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Description / observations</label>
                <textarea class="form-control" @bind="CurrentMaintenance.Description" rows="3" placeholder="Détails, pièces changées, prochaine échéance..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="CancelForm">Annuler</button>
                <button class="btn btn-custom-success" @onclick="SaveMaintenance" disabled="@UploadingFile">
                    <i class="bi bi-save me-1"></i> Enregistrer
                </button>
            </div>
        </div>
    }

    @if (Maintenances == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Chargement de l'historique...</p>
        </div>
    }
    else if (!FilteredMaintenances.Any())
    {
        <div class="alert alert-info text-center">Aucune intervention ne correspond aux critères.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th style="width:40px">
                            <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" title="Tout sélectionner" />
                        </th>
                        <th>Date</th>
                        <th>Véhicule</th>
                        <th>Interventions</th>
                        <th>Km</th>
                        <th>Fournisseur</th>
                        <th>Coût</th>
                        <th>Facture</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in FilteredMaintenances)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@SelectedIds.Contains(m.Id)" @onchange="e => ToggleRowSelection(m.Id, e.Value)" />
                            </td>
                            <td>@m.DateIntervention.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-navy">@GetVehicleLabel(m)</span></td>
                            <td>
                                @foreach (var tag in SplitTypes(m.TypeIntervention))
                                {
                                    <span class="badge bg-steel me-1 mb-1">@tag</span>
                                }
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <small class="d-block text-muted mt-1">@m.Description</small>
                                }
                            </td>
                            <td>@(m.KilometrageIntervention > 0 ? $"{m.KilometrageIntervention:N0} km" : "—")</td>
                            <td>@m.Fournisseur</td>
                            <td class="text-bold text-red">@m.Cout.ToString("N3") DT</td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.Facture))
                                {
                                    var fileUrl = ApiUrlHelper.FileUrl(Http, m.Facture);
                                    <a href="@fileUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-navy me-1" title="Modifier" @onclick="() => EditMaintenance(m)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Supprimer" @onclick="() => DeleteMaintenance(m.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly string[] InterventionTypes =
    {
        "Vidange", "Freinage", "Pneumatiques", "Courroie distribution",
        "Batterie", "Climatisation", "Parallélisme", "Révision générale",
        "Carrosserie", "Autre"
    };

    private List<MaintenanceDto>? Maintenances;
    private List<VehiculeDto> Vehicles = new();
    private MaintenanceDto CurrentMaintenance = new() { DateIntervention = DateTime.Today };
    private HashSet<int> SelectedVehicleIds = new();
    private int LastSelectedVehicleId;
    private HashSet<string> SelectedInterventionTypes = new();
    private HashSet<int> SelectedIds = new();
    private string AutreIntervention = "";
    private string SearchTerm = "";
    private int FilterVehiculeId;
    private string FilterType = "";
    private bool ShowForm;
    private bool UploadingFile;

    private IEnumerable<MaintenanceDto> FilteredMaintenances
    {
        get
        {
            if (Maintenances == null) return Enumerable.Empty<MaintenanceDto>();
            var q = Maintenances.AsEnumerable();
            if (FilterVehiculeId > 0)
                q = q.Where(m => m.VehiculeId == FilterVehiculeId);
            if (!string.IsNullOrWhiteSpace(FilterType))
                q = q.Where(m => m.TypeIntervention.Contains(FilterType, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                q = q.Where(m =>
                    (m.TypeIntervention?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Fournisseur?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Description?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.VehiculeImmatriculation?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q.OrderByDescending(m => m.DateIntervention);
        }
    }

    private bool AllVisibleSelected =>
        FilteredMaintenances.Any() && FilteredMaintenances.All(m => SelectedIds.Contains(m.Id));

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            Maintenances = await Http.GetFromJsonAsync<List<MaintenanceDto>>("Maintenance") ?? new();
            Vehicles = await Http.GetFromJsonAsync<List<VehiculeDto>>("Vehicules") ?? new();
        }
        catch (Exception ex)
        {
            Maintenances = new();
            Console.WriteLine("Error loading maintenance: " + ex.Message);
        }
    }

    private void OnSearchChanged(ChangeEventArgs e) => SearchTerm = e.Value?.ToString() ?? "";

    private void ShowAddForm()
    {
        CurrentMaintenance = new MaintenanceDto { DateIntervention = DateTime.Today };
        SelectedVehicleIds = Vehicles.Count > 0 ? new HashSet<int> { Vehicles[0].Id } : new();
        LastSelectedVehicleId = Vehicles.FirstOrDefault()?.Id ?? 0;
        SelectedInterventionTypes = new HashSet<string>();
        AutreIntervention = "";
        SyncKilometrageFromSelection();
        ShowForm = true;
    }

    private void CancelForm() => ShowForm = false;

    private void EditMaintenance(MaintenanceDto m)
    {
        CurrentMaintenance = new MaintenanceDto
        {
            Id = m.Id,
            VehiculeId = m.VehiculeId,
            TypeIntervention = m.TypeIntervention,
            Description = m.Description,
            DateIntervention = m.DateIntervention,
            KilometrageIntervention = m.KilometrageIntervention,
            Cout = m.Cout,
            Fournisseur = m.Fournisseur,
            Facture = m.Facture,
            VehiculeImmatriculation = m.VehiculeImmatriculation
        };
        SelectedInterventionTypes = SplitTypes(m.TypeIntervention).ToHashSet();
        AutreIntervention = SelectedInterventionTypes.Contains("Autre")
            ? m.TypeIntervention.Split('|', StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .FirstOrDefault(t => !InterventionTypes.Contains(t)) ?? ""
            : "";
        OnEditVehicleChanged();
        ShowForm = true;
    }

    private VehiculeDto? GetVehicle(int id) => Vehicles.FirstOrDefault(v => v.Id == id);

    private string GetVehicleLabel(MaintenanceDto m)
    {
        var immat = m.VehiculeImmatriculation;
        var marque = m.VehiculeMarque;
        var modele = m.VehiculeModele;

        if (string.IsNullOrWhiteSpace(immat))
        {
            var vehicle = GetVehicle(m.VehiculeId);
            if (vehicle != null)
            {
                immat = vehicle.Immatriculation;
                marque = vehicle.Marque;
                modele = vehicle.Modele;
            }
        }

        if (string.IsNullOrWhiteSpace(immat))
            return "—";

        if (!string.IsNullOrWhiteSpace(marque) || !string.IsNullOrWhiteSpace(modele))
            return $"{immat} — {marque} {modele}".Trim();

        return immat;
    }

    private void SyncKilometrageFromSelection()
    {
        if (SelectedVehicleIds.Count == 1)
        {
            var vehicle = GetVehicle(SelectedVehicleIds.First());
            CurrentMaintenance.KilometrageIntervention = vehicle?.Kilometrage ?? 0;
        }
        else if (SelectedVehicleIds.Count == 0)
        {
            CurrentMaintenance.KilometrageIntervention = 0;
        }
        else
        {
            CurrentMaintenance.KilometrageIntervention = GetVehicle(LastSelectedVehicleId)?.Kilometrage ?? 0;
        }
    }

    private void OnEditVehicleChanged()
    {
        var vehicle = GetVehicle(CurrentMaintenance.VehiculeId);
        CurrentMaintenance.KilometrageIntervention = vehicle?.Kilometrage ?? 0;
        CurrentMaintenance.VehiculeImmatriculation = vehicle?.Immatriculation ?? "";
    }

    private void ToggleVehicle(int id, object? value)
    {
        if (value is bool b && b)
        {
            SelectedVehicleIds.Add(id);
            LastSelectedVehicleId = id;
        }
        else SelectedVehicleIds.Remove(id);
        SyncKilometrageFromSelection();
    }

    private void ToggleInterventionType(string type, object? value)
    {
        if (value is bool b && b) SelectedInterventionTypes.Add(type);
        else SelectedInterventionTypes.Remove(type);
    }

    private void ToggleRowSelection(int id, object? value)
    {
        if (value is bool b && b) SelectedIds.Add(id);
        else SelectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool all && all)
        {
            foreach (var m in FilteredMaintenances)
                SelectedIds.Add(m.Id);
        }
        else
        {
            foreach (var m in FilteredMaintenances)
                SelectedIds.Remove(m.Id);
        }
    }

    private string BuildTypeIntervention()
    {
        var types = SelectedInterventionTypes.Where(t => t != "Autre").ToList();
        if (SelectedInterventionTypes.Contains("Autre") && !string.IsNullOrWhiteSpace(AutreIntervention))
            types.Add(AutreIntervention.Trim());
        else if (SelectedInterventionTypes.Contains("Autre"))
            types.Add("Autre");
        return string.Join(" | ", types);
    }

    private async Task SaveMaintenance()
    {
        var typeText = BuildTypeIntervention();
        if (string.IsNullOrWhiteSpace(typeText))
        {
            await Dialog.ShowWarningAsync("Sélectionnez au moins un type d'intervention.");
            return;
        }

        CurrentMaintenance.TypeIntervention = typeText;

        try
        {
            if (CurrentMaintenance.Id == 0)
            {
                if (SelectedVehicleIds.Count == 0)
                {
                    await Dialog.ShowWarningAsync("Sélectionnez au moins un véhicule.");
                    return;
                }

                var successCount = 0;
                foreach (var vehiculeId in SelectedVehicleIds)
                {
                    var vehicle = GetVehicle(vehiculeId);
                    var dto = new MaintenanceDto
                    {
                        VehiculeId = vehiculeId,
                        VehiculeImmatriculation = vehicle?.Immatriculation ?? "",
                        VehiculeMarque = vehicle?.Marque ?? "",
                        VehiculeModele = vehicle?.Modele ?? "",
                        TypeIntervention = CurrentMaintenance.TypeIntervention,
                        Description = CurrentMaintenance.Description,
                        DateIntervention = CurrentMaintenance.DateIntervention,
                        KilometrageIntervention = vehicle?.Kilometrage ?? CurrentMaintenance.KilometrageIntervention,
                        Cout = CurrentMaintenance.Cout,
                        Fournisseur = CurrentMaintenance.Fournisseur,
                        Facture = CurrentMaintenance.Facture
                    };
                    var response = await Http.PostAsJsonAsync("Maintenance", dto);
                    if (response.IsSuccessStatusCode) successCount++;
                }

                if (successCount > 0)
                {
                    ShowForm = false;
                    await LoadData();
                    await Dialog.ShowSuccessAsync($"{successCount} intervention(s) enregistrée(s).");
                }
                else
                {
                    await Dialog.ShowErrorAsync("Erreur lors de l'enregistrement.");
                }
            }
            else
            {
                if (CurrentMaintenance.VehiculeId == 0)
                {
                    await Dialog.ShowWarningAsync("Veuillez choisir un véhicule.");
                    return;
                }

                var response = await Http.PutAsJsonAsync($"Maintenance/{CurrentMaintenance.Id}", CurrentMaintenance);
                if (response.IsSuccessStatusCode)
                {
                    ShowForm = false;
                    await LoadData();
                    await Dialog.ShowSuccessAsync("Intervention modifiée.");
                }
                else
                {
                    await Dialog.ShowErrorAsync("Erreur lors de la modification.");
                }
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowErrorAsync("Erreur: " + ex.Message);
        }
    }

    private async Task DeleteMaintenance(int id)
    {
        var confirm = await Dialog.ShowConfirmAsync("Supprimer cette intervention ?");
        if (!confirm) return;
        await DeleteByIds(new[] { id });
    }

    private async Task DeleteSelected()
    {
        var confirm = await Dialog.ShowConfirmAsync($"Supprimer {SelectedIds.Count} intervention(s) ?");
        if (!confirm) return;
        await DeleteByIds(SelectedIds.ToList());
    }

    private async Task DeleteByIds(IEnumerable<int> ids)
    {
        try
        {
            var deleted = 0;
            foreach (var id in ids)
            {
                var response = await Http.DeleteAsync($"Maintenance/{id}");
                if (response.IsSuccessStatusCode) deleted++;
            }
            SelectedIds.Clear();
            await LoadData();
            await Dialog.ShowSuccessAsync($"{deleted} intervention(s) supprimée(s).");
        }
        catch (Exception ex)
        {
            await Dialog.ShowErrorAsync("Erreur: " + ex.Message);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        UploadingFile = true;
        try
        {
            await using var readStream = file.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await readStream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();

            var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(bytes), "file", file.Name);
            var response = await Http.PostAsync("Documents/upload", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                    CurrentMaintenance.Facture = result.Url;
            }
            else
            {
                await Dialog.ShowErrorAsync("Erreur lors du transfert du fichier.");
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowErrorAsync("Erreur transfert: " + ex.Message);
        }
        finally
        {
            UploadingFile = false;
        }
    }

    private static IEnumerable<string> SplitTypes(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? Enumerable.Empty<string>()
            : value.Split('|', StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim());

    private static string GetFileName(string path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var idx = path.LastIndexOf('_');
        return idx >= 0 ? path[(idx + 1)..] : Path.GetFileName(path);
    }

    private class UploadResult
    {
        public string Url { get; set; } = "";
    }
}
