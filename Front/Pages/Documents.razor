@page "/documents"
@using ParckingAuto.DTO
@using Front.Helpers
@inject HttpClient Http
@inject DialogService Dialog

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="title-custom"><i class="bi bi-file-earmark-text me-2"></i>Gestion Documentaire</h2>
        <button class="btn btn-custom-primary" @onclick="ShowUploadForm">
            <i class="bi bi-upload me-1"></i> Archiver un Document
        </button>
    </div>

    @if (ShowForm)
    {
        <div class="card card-custom p-4 mb-4 animate-slide-down">
            <h4 class="mb-3 text-navy">Archiver un nouveau document</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Véhicule associé</label>
                    <select class="form-select" @bind="NewDoc.VehiculeId">
                        <option value="0">-- Choisir un véhicule --</option>
                        @foreach (var v in Vehicles)
                        {
                            <option value="@v.Id">@v.Marque @v.Modele - @v.Immatriculation</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Type de document</label>
                    <select class="form-select" @bind="NewDoc.TypeDocument">
                        <option value="CarteGrise">Carte Grise</option>
                        <option value="Assurance">Assurance</option>
                        <option value="Facture">Facture</option>
                        <option value="BonReparation">Bon de Réparation</option>
                        <option value="VisiteTechnique">Visite Technique</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Choisir le fichier (PDF, Image...)</label>
                <InputFile OnChange="HandleFileSelected" class="form-control" />
                @if (Uploading)
                {
                    <div class="text-info mt-1"><i class="spinner-border spinner-border-sm me-1"></i> Upload en cours...</div>
                }
                else if (!string.IsNullOrEmpty(NewDoc.Fichier))
                {
                    <div class="text-success mt-1">
                        <i class="bi bi-check-circle-fill me-1"></i> Fichier prêt : @GetFileName(NewDoc.Fichier)
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="CancelForm">Annuler</button>
                <button class="btn btn-custom-success" @onclick="SaveDocument" disabled="@(Uploading || string.IsNullOrEmpty(NewDoc.Fichier))">
                    <i class="bi bi-save me-1"></i> Archiver
                </button>
            </div>
        </div>
    }

    @if (documentsList == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Chargement des archives...</p>
        </div>
    }
    else if (!documentsList.Any())
    {
        <div class="alert alert-info text-center">Aucun document dans les archives.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var d in documentsList)
            {
                <div class="col">
                    <div class="card card-custom h-100 shadow-sm card-hover-effect">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-custom-type">@FormatDocType(d.TypeDocument)</span>
                                <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@d.DateUpload.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="card-title text-navy">
                                @GetFileName(d.Fichier)
                            </h5>
                            <p class="card-text">
                                <span class="badge bg-navy">Véhicule: @d.VehiculeImmatriculation</span>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-between pb-3">
                            @{
                                var fileUrl = ApiUrlHelper.FileUrl(Http, d.Fichier);
                            }
                            <a href="@fileUrl" target="_blank" class="btn btn-sm btn-custom-primary flex-grow-1 me-2">
                                <i class="bi bi-eye me-1"></i> Consulter
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDocument(d.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .bg-custom-type {
        background-color: #669BBC;
        color: #003049;
        font-weight: 600;
    }
</style>

@code {
    private List<DocumentDto> documentsList;
    private List<VehiculeDto> Vehicles = new();
    private DocumentDto NewDoc = new() { TypeDocument = "CarteGrise" };
    private bool ShowForm = false;
    private bool Uploading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            documentsList = await Http.GetFromJsonAsync<List<DocumentDto>>("Documents");
            Vehicles = await Http.GetFromJsonAsync<List<VehiculeDto>>("Vehicules");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading documents: " + ex.Message);
        }
    }

    private void ShowUploadForm()
    {
        NewDoc = new DocumentDto { TypeDocument = "CarteGrise", VehiculeId = Vehicles.FirstOrDefault()?.Id ?? 0 };
        ShowForm = true;
    }

    private void CancelForm()
    {
        ShowForm = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        Uploading = true;
        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StreamContent(file.OpenReadStream(10 * 1024 * 1024)), "file", file.Name);

            var response = await Http.PostAsync("Documents/upload", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    NewDoc.Fichier = result.Url;
                }
            }
            else
            {
                await Dialog.ShowErrorAsync("Erreur lors du transfert du fichier.");
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowAlertAsync("Erreur transfert: " + ex.Message);
        }
        finally
        {
            Uploading = false;
        }
    }

    private async Task SaveDocument()
    {
        if (NewDoc.VehiculeId == 0)
        {
            await Dialog.ShowWarningAsync("Veuillez choisir un véhicule.");
            return;
        }

        NewDoc.DateUpload = DateTime.Now;

        try
        {
            var response = await Http.PostAsJsonAsync("Documents", NewDoc);
            if (response.IsSuccessStatusCode)
            {
                ShowForm = false;
                await LoadData();
                await Dialog.ShowAlertAsync("Document archivé avec succès.");
            }
            else
            {
                await Dialog.ShowErrorAsync("Erreur lors de la sauvegarde.");
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowErrorAsync("Erreur: " + ex.Message);
        }
    }

    private async Task DeleteDocument(int id)
    {
        var confirm = await Dialog.ShowConfirmAsync("Voulez-vous vraiment supprimer ce document de l'archive ?");
        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"Documents/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                await Dialog.ShowAlertAsync("Document supprimé.");
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowErrorAsync("Erreur: " + ex.Message);
        }
    }

    private string GetFileName(string path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var idx = path.LastIndexOf('_');
        return idx >= 0 ? path.Substring(idx + 1) : Path.GetFileName(path);
    }

    private string FormatDocType(string type)
    {
        return type switch
        {
            "CarteGrise" => "Carte Grise",
            "Assurance" => "Assurance",
            "Facture" => "Facture",
            "BonReparation" => "Bon de Réparation",
            "VisiteTechnique" => "Visite Technique",
            _ => type
        };
    }

    private class UploadResult
    {
        public string Url { get; set; } = "";
        public string FileName { get; set; } = "";
    }
}
