@page "/vehicule/{Id:int}"
@using ParckingAuto.DTO
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="mb-4">Détails du véhicule</h3>

@if (IsLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}
else if (ErrorMessage != null)
{
    <div class="alert alert-danger">@ErrorMessage</div>
    <button class="btn btn-secondary mt-2" @onclick="GoBack">Retour</button>
}
else if (Vehicule != null)
{
    <div class="card shadow p-4 mb-4">
        <div class="d-flex align-items-center mb-3">
            <div class="flex-grow-1">
                <h4 class="card-title mb-1">@Vehicule.Marque @Vehicule.Modele</h4>
                <span class="badge bg-info text-dark me-2">@Vehicule.TypeCarburant</span>
                <span class="badge bg-secondary">@Vehicule.AnneeFabrication</span>
            </div>
            <button class="btn btn-outline-secondary" @onclick="GoBack">Retour</button>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Immatriculation :</strong> @Vehicule.Immatriculation</li>
            <li class="list-group-item"><strong>Kilométrage :</strong> @Vehicule.Kilometrage.ToString("N0") km</li>
            <li class="list-group-item"><strong>Assurance :</strong> @Vehicule.Assurance</li>
        </ul>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private VehiculeDto? Vehicule;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Vehicule = await Http.GetFromJsonAsync<VehiculeDto>($"Vehicules/{Id}");
            if (Vehicule == null)
            {
                ErrorMessage = "Véhicule introuvable.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors du chargement : {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    void GoBack()
    {
        Navigation.NavigateTo("/vehicules");
    }
}
