@page "/vehicule/{Id:int}"
@using ParckingAuto.DTO
@inject HttpClient Http

<h3>Détails du véhicule</h3>

@if (Vehicule != null)
{
    <div class="card p-3">
        <h5>@Vehicule.Marque @Vehicule.Modele</h5>
        <p>Immatriculation : @Vehicule.Immatriculation</p>
        <p>Kilométrage : @Vehicule.Kilometrage km</p>
        <p>Type carburant : @Vehicule.TypeCarburant</p>
        <p>Assurance : @Vehicule.Assurance</p>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private VehiculeDto Vehicule;

    protected override async Task OnInitializedAsync()
    {
        Vehicule = await Http.GetFromJsonAsync<VehiculeDto>($"Vehicules/{Id}");
    }
}
