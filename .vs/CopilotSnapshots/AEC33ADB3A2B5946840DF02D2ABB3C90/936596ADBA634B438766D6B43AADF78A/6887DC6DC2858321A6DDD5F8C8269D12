using System.Net.Http.Json;
using System.Collections.Generic;
using System.Threading.Tasks;

public class MaintenanceService
{
    private readonly HttpClient _http;

    public MaintenanceService(HttpClient http)
    {
        _http = http;
    }

    public async Task<List<MaintenanceDto>> GetAllAsync()
        => await _http.GetFromJsonAsync<List<MaintenanceDto>>("Maintenance");

    public async Task AddAsync(MaintenanceDto maintenance)
        => await _http.PostAsJsonAsync("Maintenance", maintenance);
}
