@page "/login"
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Connexion</h3>

<div class="card p-4 shadow-sm" style="max-width:400px;">
    <div class="mb-3">
        <label>Email</label>
        <input @bind="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Mot de passe</label>
        <input @bind="Password" type="password" class="form-control" />
    </div>
    <button class="btn btn-primary w-100" @onclick="DoLogin">Se connecter</button>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">@ErrorMessage</div>
}

@code {
    private string Email = "";
    private string Password = "";
    private string ErrorMessage = "";

    private async Task DoLogin()
    {
        var result = await AuthService.LoginAsync(Email, Password);
        if (result.Success)
        {
            // Redirection selon rôle
            switch (result.Role)
            {
                case "Administrateur":
                    Nav.NavigateTo("/dashboard");
                    break;
                case "Gestionnaire":
                    Nav.NavigateTo("/vehicules");
                    break;
                case "Chauffeur":
                    Nav.NavigateTo("/mouvements");
                    break;
                default:
                    Nav.NavigateTo("/");
                    break;
            }
        }
        else
        {
            ErrorMessage = "Email ou mot de passe incorrect";
            await JS.InvokeVoidAsync("alert", ErrorMessage);
        }
    }
}
