@page "/alertes"
@using ParckingAuto.DTO
@inject HttpClient Http

<h3>Système d’alertes</h3>

<ul class="list-group">
    @foreach (var a in alertes)
    {
        <li class="list-group-item">
            <strong>@a.TypeAlerte</strong> - @a.Statut
            <span class="badge bg-danger">@a.DateAlerte.ToString("dd/MM/yyyy")</span>
        </li>
    }
</ul>

@code {
    private List<AlerteDto> alertes = new();

    protected override async Task OnInitializedAsync()
    {
        alertes = await Http.GetFromJsonAsync<List<AlerteDto>>("Alertes");
    }
}
