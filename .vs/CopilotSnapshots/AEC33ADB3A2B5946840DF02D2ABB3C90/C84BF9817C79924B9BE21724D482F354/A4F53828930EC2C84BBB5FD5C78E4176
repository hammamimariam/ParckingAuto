using System.Net.Http.Json;
using System.Collections.Generic;
using System.Threading.Tasks;

public class CarburantService
{
    private readonly HttpClient _http;

    public CarburantService(HttpClient http)
    {
        _http = http;
    }

    public async Task<List<CarburantDto>> GetAllAsync()
        => await _http.GetFromJsonAsync<List<CarburantDto>>("Carburant");

    public async Task AddAsync(CarburantDto carburant)
        => await _http.PostAsJsonAsync("Carburant", carburant);
}
